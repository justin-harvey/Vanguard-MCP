{
  "name": "@civic-chain/auditor",
  "version": "1.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "The Civic-Chain Grant & Budget Auditor engine: the model writes SQL, the database produces the numbers, and every answer carries a verifiable provenance chain.",
  "homepage": "https://civic-chain.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-harvey/Vanguard-MCP.git",
    "directory": "auditor-core"
  },
  "bugs": {
    "url": "https://github.com/justin-harvey/Vanguard-MCP/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "auditor": "bin/auditor.js",
    "cc-auditor": "bin/auditor.js",
    "civic-chain-auditor": "bin/auditor.js"
  },
  "files": [
    "bin/",
    "src/",
    "db/*.sql",
    "db/*.md",
    "assets/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "seed": "node bin/auditor.js seed",
    "ask": "node bin/auditor.js ask",
    "audit": "node bin/auditor.js audit",
    "doctor": "node bin/auditor.js doctor",
    "mcp": "node bin/auditor.js mcp",
    "build:demo": "node scripts/build-demo.js",
    "eval": "node --test test/skill-eval.test.js",
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-sql-parser": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "sql.js": "^1.16.0"
  }
}
